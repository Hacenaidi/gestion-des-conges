<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="12.0" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.leavemng.controllers.admin.ViewUsersController">
    <children>
        <Label text="Users List">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>
        <TableView fx:id="usersTable" prefHeight="360.0" prefWidth="850.0">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="60.0" />
                <TableColumn fx:id="usernameColumn" text="Username" prefWidth="170.0" />
                <TableColumn fx:id="phoneColumn" text="Phone" prefWidth="140.0" />
                <TableColumn fx:id="departementColumn" text="Department" prefWidth="150.0" />
                <TableColumn fx:id="annualBalanceColumn" text="Balance" prefWidth="100.0" />
                <TableColumn fx:id="adminColumn" text="Admin" prefWidth="70.0" />
                    <TableColumn fx:id="deleteColumn" text="Delete" prefWidth="80.0" />
            </columns>
        </TableView>
        <HBox spacing="12.0" alignment="CENTER">
            <children>
            <Label text="New balance" />
                <TextField fx:id="balanceField" promptText="New balance" prefWidth="150.0" />
                <Button text="Load Selected" onAction="#handleLoadSelectedBalanceButtonAction" />
                <Button text="Update Balance" onAction="#handleUpdateBalanceButtonAction" />
                <Button text="Back" onAction="#handleDashboardButtonAction" />
            </children>
        </HBox>
        <Label fx:id="messageLabel" id="messageLabel" />
    </children>
</VBox>